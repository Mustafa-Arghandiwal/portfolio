---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="bg-black text-gray-200 font-expo px-4 pt-8">
		<header class="sticky top-0 z-10 px-4 py-1.5 backdrop-blur-md">
			<div
				class="flex items-center justify-between max-w-[60ch] 2xl:max-w-[80ch] mx-auto"
			>
				<a
					href="/"
					class="font-reospec z-10 text-3xl sm:text-4xl cursor-pointer font-bold hover:text-[#DB5413] duration-75"
					>M</a
				>
				<div
					class="z-10 flex gap-8 items-center justify-center text-sm"
				>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/projects">Projects</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/blog">Blog</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/contact">Contact</a
					>
				</div>
			</div>
		</header>
		<slot />
		<footer class="grid mt-auto place-items-center">
			<div class="flex gap-2 items-center">
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:github"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="twitter"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:mail"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
			</div>
		</footer>
	</body>
</html>
