		<header
			class="text-text sticky top-0 z-10 px-4 py-1.5 backdrop-blur-xs bg-linear-to-b from-bg/90 to-bg/50"
		>
			<div
				class="flex items-center justify-between max-w-[620px] 2xl:max-w-[780px] mx-auto"
			>
				<div
					class="font-semibold flex gap-1.5 flex-wrap items-center"
				>
					<BreadCrumbs />
				</div>
				<div class="flex gap-8 items-center">
					<!-- ----Desktop Links----- -->
					<div
						class="z-10 hidden sm:flex gap-8 items-center font-semibold justify-center text-sm"
					>
						<a
							class="cursor-pointer hover:text-primary duration-75"
							href="/projects"
							>Projects</a
						>
						<a
							class="cursor-pointer hover:text-primary duration-75"
							href="/blog">Blog</a
						>
						<a
							class="cursor-pointer hover:text-primary duration-75"
							href="/about">About</a
						>
					</div>

					<!-- ----Theme Menu---- -->
					<div class="relative">
						<Icon
							name="lucide:palette"
							id="theme-btn"
							class="w-5 h-5 cursor-pointer hover:text-primary active:scale-110 duration-100"
						/>

						<div
							id="theme-menu"
							class="*:min-w-28 *:py-0.5 *:cursor-pointer *:rounded-sm *:hover:ring-2 *: *:ring-primary absolute right-0 top-8 p-2 rounded-md text-sm hidden flex-col gap-2 font-semibold bg-bg-card/90 z-50"
						>
							<button
								class="bg-[#eff1f5] text-[#4c4f69] theme"
							>
								Latte
							</button>
							<button
								class="bg-[#303446] text-[#c6d0f5] theme"
							>
								Frappe
							</button>
							<button
								class="bg-[#24273a] text-[#cad3f5] theme"
							>
								Macchiato
							</button>
							<button
								class="bg-[#1e1e2e] text-[#cdd6f4] theme"
							>
								Mocha
							</button>
							<button
								class="bg-[#282828] text-[#ebdbb2] theme"
							>
								Gruvbox Dark
							</button>
							<button
								class="bg-[#fbf1c7] text-[#3c3836] theme"
							>
								Gruvbox Light
							</button>
							<button
								class="bg-[#191724] text-[#e0def4] theme"
							>
								Rose pine
							</button>
						</div>
					</div>

					<!-- ----Theme Menu---- -->

					<!-- ----Hamburger Menu---- -->
					<div class="relative sm:hidden">
						<Icon
							name="lucide:menu"
							class="w-5 h-5 cursor-pointer hover:text-primary active:scale-110 duration-100"
							id="menu-btn"
						/>
						<div
							id="menu"
							class="absolute py-2 rounded-md top-8 right-0 text-sm hidden gap-2 flex-col font-semibold bg-bg-card/90 z-50"
						>
							<a
								class="cursor-pointer hover:text-primary duration-75 px-4"
								href="/projects"
								>Projects</a
							>
							<a
								class="cursor-pointer hover:text-primary duration-75 px-4"
								href="/blog"
								>Blog</a
							>
							<a
								class="cursor-pointer hover:text-primary duration-75 px-4"
								href="/about"
								>About</a
							>
						</div>
					</div>
					<!-- ----Hamburger Menu---- -->
				</div>
			</div>
		</header>

		<!-- Main content -->
		<main class="px-5 xs:px-6 pt-12 pb-4" transition:animate="fade">
			<slot />
		</main>

		<footer class="flex items-center justify-center gap-8 min-h-14">
			<div class="flex gap-1 items-center">
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:github"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="twitter"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:mail"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
			</div>
			<Icon
				name="not_ai_badge"
				class="w-22 h-full opacity-60 hover:opacity-100 duration-150"
			/>
		</footer>
	</body>
</html>

<script>
	document.addEventListener("astro:after-swap", () => {
		const savedTheme = localStorage.getItem("theme") || "mocha";
		document.documentElement.dataset.theme = savedTheme;
	});
	document.addEventListener("astro:page-load", () => {
		const menuBtn = document.getElementById("menu-btn");
		const menu = document.getElementById("menu");
		const themeBtn = document.getElementById("theme-btn");
		const themeMenu = document.getElementById("theme-menu");

		function isMenuOpen() {
			return menu && !menu.classList.contains("hidden");
		}
		function isThemeMenuOpen() {
			return (
				themeMenu &&
				!themeMenu.classList.contains("hidden")
			);
		}

		menuBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			menu?.classList.toggle("hidden");
			menu?.classList.toggle("flex");
		});

		themeBtn?.addEventListener("click", (e) => {
			e.stopPropagation();
			themeMenu?.classList.toggle("hidden");
			themeMenu?.classList.toggle("flex");
		});
		document.body.addEventListener(
			"click",
			(e) => {
				if (!menu || !menuBtn || !isMenuOpen()) return;
				const target = e.target as Node;
				if (
					!menuBtn.contains(target) &&
					!menu.contains(target)
				) {
					e.preventDefault();
					e.stopPropagation();
					menu?.classList.add("hidden");
					menu?.classList.remove("flex");
				}
			},
			true,
		);

		document.body.addEventListener(
			"click",
			(e) => {
				if (
					!themeMenu ||
					!themeBtn ||
					!isThemeMenuOpen()
				)
					return;
				const target = e.target as Node;
				if (
					!themeBtn.contains(target) &&
					!themeMenu.contains(target)
				) {
					e.preventDefault();
					e.stopPropagation();
					themeMenu?.classList.add("hidden");
					themeMenu?.classList.remove("flex");
				}
			},
			true,
		);

		const themeBtns = document.querySelectorAll("button.theme");
		function updateThemeRing(activeTheme: string) {
			themeBtns.forEach((btn) =>
				btn.classList.toggle(
					"ring-2",
					btn.innerText.trim().toLowerCase() ===
						activeTheme,
				),
			);
		}
		updateThemeRing(localStorage.getItem("theme") || "mocha");
		function setTheme(theme: string) {
			document.documentElement.dataset.theme = theme;
			localStorage.setItem("theme", theme);
			updateThemeRing(theme);
		}
		themeBtns.forEach((btn) => {
			btn.addEventListener("click", () =>
				setTheme(btn.innerText.trim().toLowerCase()),
			);
		});
	});
</script>
