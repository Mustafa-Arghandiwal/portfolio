---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="bg-black text-gray-200 relative font-expo px-4 pt-8">
		<div
			class="absolute top-0 left-0 right-0 h-screen -z-10 overflow-hidden"
			style="
				background-image: 
					linear-gradient(to right, #4f4f4f2e 1px, transparent 1px),
					linear-gradient(to bottom, #4f4f4f2e 1px, transparent 1px);
				background-size: 18px 26px;
				-webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
				mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
			"
		>
		</div>

		<!-- <div class="bg-[#0f0f0f] text-white"> -->
		<!-- 	<div -->
		<!-- 		class="absolute inset-0 z-0 pointer-events-none" -->
		<!-- 		style={{ -->
		<!-- 			backgroundImage: ` -->
		<!--       repeating-linear-gradient(0deg, transparent, transparent 5px, rgba(99, 102, 241, 0.15) 5px, rgba(99, 102, 241, 0.15) 6px, transparent 6px, transparent 15px), -->
		<!--       repeating-linear-gradient(90deg, transparent, transparent 5px, rgba(99, 102, 241, 0.15) 5px, rgba(99, 102, 241, 0.15) 6px, transparent 6px, transparent 15px), -->
		<!--       repeating-linear-gradient(0deg, transparent, transparent 10px, rgba(139, 92, 246, 0.12) 10px, rgba(139, 92, 246, 0.12) 11px, transparent 11px, transparent 30px), -->
		<!--       repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(139, 92, 246, 0.12) 10px, rgba(139, 92, 246, 0.12) 11px, transparent 11px, transparent 30px) -->
		<!--     `, -->
		<!-- 		}} -->
		<!-- 	> -->
		<!-- 	</div> -->
		<!-- </div> -->

		<!-- <div -->
		<!-- 	class="h-0 w-120 absolute top-0 left-1/2 -translate-x-1/2 shadow-[0_0_400px_30px_#1100F8] rotate-140" -->
		<!-- > -->
		<!-- </div> -->

		<header
			class="sticky top-0 z-10 px-4 py-1.5 backdrop-blur-md backdrop-brightness-130"
		>
			<div
				class="flex items-center justify-between max-w-[620px] 2xl:max-w-[780px] mx-auto"
			>
				<a
					href="/"
					class="font-reospec z-10 text-4xl cursor-pointer font-bold hover:text-[#DB5413] duration-75"
					>M</a
				>
				<div
					class="z-10 hidden sm:flex gap-8 items-center font-semibold justify-center text-sm"
				>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75"
						href="/projects">Projects</a
					>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75"
						href="/blog">Blog</a
					>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75"
						href="/contact">Contact</a
					>
				</div>

				<Icon
					name="lucide:menu"
					class="w-5 h-5 active:scale-110 duration-100 sm:hidden"
					id="menu-btn"
				/>
				<div
					id="menu"
					class="absolute py-2 max-w-[150px] w-full rounded-md top-10 right-4 text-sm hidden gap-2 flex-col border border-white/20 bg-black/80 z-50"
				>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75 px-4"
						href="/projects">Projects</a
					>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75 px-4"
						href="/blog">Blog</a
					>
					<a
						class="cursor-pointer hover:opacity-80 hover:text-[#DB5413] duration-75 px-4"
						href="/contact">Contact</a
					>
				</div>
			</div>
		</header>

		<!-- Main content -->
		<main class="px-3 xs:px-4 pt-12 pb-4">
			<slot />
		</main>

		<footer class="flex items-center justify-center gap-8 min-h-14">
			<div class="flex gap-1 items-center">
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:github"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="twitter"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:mail"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
			</div>
			<Icon
				name="not_ai_badge"
				class="w-22 h-full opacity-60 hover:opacity-100 duration-150"
			/>
		</footer>
	</body>
</html>

<script>
	const menuBtn = document.getElementById("menu-btn");
	const menu = document.getElementById("menu");
	function isMenuOpen() {
		return menu && !menu.classList.contains("hidden");
	}
	menuBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		menu?.classList.toggle("hidden");
		menu?.classList.toggle("flex");
	});
	document.body.addEventListener(
		"click",
		(e) => {
			if (!menu || !menuBtn || !isMenuOpen()) return;
			const target = e.target as Node;
			if (
				!menuBtn.contains(target) &&
				!menu.contains(target)
			) {
				e.preventDefault();
				e.stopImmediatePropagation();
				menu?.classList.add("hidden");
				menu?.classList.remove("flex");
			}
		},
		true,
	);
</script>
