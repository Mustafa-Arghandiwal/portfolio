---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body class="bg-black text-gray-200 relative font-expo px-4 pt-8">
		<div
			class="absolute top-0 left-0 right-0 h-screen -z-10 overflow-hidden"
			style="
				background-image: 
					linear-gradient(to right, #4f4f4f2e 1px, transparent 1px),
					linear-gradient(to bottom, #4f4f4f2e 1px, transparent 1px);
				background-size: 18px 26px;
				-webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
				mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
			"
		>
		</div>

		<!-- <div class="bg-[#0f0f0f] text-white"> -->
		<!-- 	<div -->
		<!-- 		class="absolute inset-0 z-0 pointer-events-none" -->
		<!-- 		style={{ -->
		<!-- 			backgroundImage: ` -->
		<!--       repeating-linear-gradient(0deg, transparent, transparent 5px, rgba(99, 102, 241, 0.15) 5px, rgba(99, 102, 241, 0.15) 6px, transparent 6px, transparent 15px), -->
		<!--       repeating-linear-gradient(90deg, transparent, transparent 5px, rgba(99, 102, 241, 0.15) 5px, rgba(99, 102, 241, 0.15) 6px, transparent 6px, transparent 15px), -->
		<!--       repeating-linear-gradient(0deg, transparent, transparent 10px, rgba(139, 92, 246, 0.12) 10px, rgba(139, 92, 246, 0.12) 11px, transparent 11px, transparent 30px), -->
		<!--       repeating-linear-gradient(90deg, transparent, transparent 10px, rgba(139, 92, 246, 0.12) 10px, rgba(139, 92, 246, 0.12) 11px, transparent 11px, transparent 30px) -->
		<!--     `, -->
		<!-- 		}} -->
		<!-- 	> -->
		<!-- 	</div> -->
		<!-- </div> -->

		<!-- <div -->
		<!-- 	class="h-0 w-120 absolute top-0 left-1/2 -translate-x-1/2 shadow-[0_0_400px_30px_#1100F8] rotate-140" -->
		<!-- > -->
		<!-- </div> -->

		<header
			class="flex gap-3 sm:gap-5 items-center justify-center px-2 md:px-8"
		>
			<a
				href="/"
				class="font-reospec z-10 text-3xl sm:text-5xl cursor-pointer font-bold hover:text-[#DB5413] duration-75"
				>M</a
			>
			<div
				class="relative border-[0.5px] mx-auto border-gray-800 z-60 flex py-4 px-4 sm:px-8 rounded-full justify-center items-center"
			>
				<div
					class="z-0 absolute inset-0 backdrop-blur-xs rounded-full"
				>
				</div>
				<div
					class="z-10 flex gap-8 items-center justify-center font-orbitron text-xs sm:text-sm"
				>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/projects">Projects</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/blog">Blog</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/contact">Contact</a
					>
				</div>
			</div>
		</header>

		<!-- Main content -->
		<main class="py-24 font-expo">
			<slot />
		</main>

		<footer class="grid place-items-center min-h-14">
			<div class="flex gap-2 items-center">
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:github"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="twitter"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:mail"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 duration-150"
					/>
				</a>
			</div>
		</footer>
	</body>
</html>
