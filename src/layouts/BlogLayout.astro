---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import TagChips from "../components/TagChips.astro";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { CollectionEntry } from "astro:content";
type Props = CollectionEntry<"blog">["data"];
export type BlogLayoutProps = CollectionEntry<"blog">["data"] & {
	id: string;
	readingTime: string;
};
const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	image,
	tags,
	readingTime,
} = Astro.props as BlogLayoutProps;
---

<script>
	let copyButtonLabel = "Copy Code";
	const codeBlocks = Array.from(
		document.querySelectorAll<HTMLPreElement>("pre"),
	);

	for (const codeBlock of codeBlocks) {
		const parent = codeBlock.parentNode;
		if (!parent) continue; // ✅ avoid null parentNode

		const wrapper = document.createElement("div");
		wrapper.style.position = "relative";

		const copyButton = document.createElement("button");
		copyButton.className = "copy-code";
		copyButton.innerHTML = copyButtonLabel;

		codeBlock.setAttribute("tabindex", "0");

		// wrap code block with relative parent element
		parent.insertBefore(wrapper, codeBlock);
		wrapper.appendChild(codeBlock);
		codeBlock.appendChild(copyButton);

		copyButton.addEventListener("click", async () => {
			await copyCode(codeBlock, copyButton);
		});
	}

	async function copyCode(
		block: HTMLPreElement,
		button: HTMLButtonElement,
	) {
		const code = block.querySelector<HTMLElement>("code");
		if (!code) return;

		const text = code.innerText;
		await navigator.clipboard.writeText(text);

		// visual feedback
		button.innerText = "Copied";
		setTimeout(() => {
			button.innerText = copyButtonLabel;
		}, 1500);
	}
</script>

<Layout pageTitle={title}>
	<article class="max-w-[65ch] 2xl:max-w-[85ch] mx-auto">
		<div
			class="flex justify-center gap-x-4 gap-y-2 items-center flex-wrap"
		>
			<Icon name="lucide:tag" />
			<TagChips tags={tags} />
		</div>
		<h1
			transition:name={title}
			class="text-4xl md:text-6xl text-center mt-4 sm:mt-8"
		>
			{title}
		</h1>

		<div class="mt-8 lg:mt-12">
			{
				image && (
					<Image
						transition:name={id}
						src={image}
						alt=""
						class=" max-h-85 object-cover rounded-md"
					/>
				)
			}
		</div>
		<div class="mt-4 mb-12 flex gap-3 justify-center items-center">
			<FormattedDate date={pubDate} />

			<span class="h-5 w-px bg-text" aria-hidden="true"
			></span>

			<div class="flex items-center gap-1.5">
				<Icon name="lucide:clock-4" class="w-5 h-5" />
				<p>
					{readingTime}
				</p>
			</div>
		</div>

		<slot />
	</article>
</Layout>
