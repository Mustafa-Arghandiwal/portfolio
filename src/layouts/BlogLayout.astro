---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";
import type { CollectionEntry } from "astro:content";
type Props = CollectionEntry<"blog">["data"];
export type BlogLayoutProps = CollectionEntry<"blog">["data"] & {
	readingTime: string;
};
const { title, description, pubDate, updatedDate, image, tags, readingTime } =
	Astro.props as BlogLayoutProps;
---

<script>
	let copyButtonLabel = "Copy Code";
	const codeBlocks = Array.from(
		document.querySelectorAll<HTMLPreElement>("pre"),
	);

	for (const codeBlock of codeBlocks) {
		const parent = codeBlock.parentNode;
		if (!parent) continue; // ✅ avoid null parentNode

		const wrapper = document.createElement("div");
		wrapper.style.position = "relative";

		const copyButton = document.createElement("button");
		copyButton.className = "copy-code";
		copyButton.innerHTML = copyButtonLabel;

		codeBlock.setAttribute("tabindex", "0");

		// wrap code block with relative parent element
		parent.insertBefore(wrapper, codeBlock);
		wrapper.appendChild(codeBlock);
		codeBlock.appendChild(copyButton);

		copyButton.addEventListener("click", async () => {
			await copyCode(codeBlock, copyButton);
		});
	}

	async function copyCode(
		block: HTMLPreElement,
		button: HTMLButtonElement,
	) {
		const code = block.querySelector<HTMLElement>("code");
		if (!code) return;

		const text = code.innerText;
		await navigator.clipboard.writeText(text);

		// visual feedback
		button.innerText = "Copied";
		setTimeout(() => {
			button.innerText = copyButtonLabel;
		}, 1500);
	}
</script>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-black text-gray-200 relative font-expo px-4 pt-8">
		<div
			class="absolute top-0 left-0 right-0 h-screen -z-10 overflow-hidden"
			style="
				background-image: 
					linear-gradient(to right, #4f4f4f2e 1px, transparent 1px),
					linear-gradient(to bottom, #4f4f4f2e 1px, transparent 1px);
				background-size: 18px 26px;
				-webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
				mask-image: radial-gradient(ellipse 60% 50% at 50% 0%, #000 70%, transparent 100%);
			"
		>
		</div>
		<header
			class="flex gap-3 sm:gap-5 relative items-center justify-center px-2 md:px-8"
		>
			<a
				href="/"
				class="xs:absolute xs:left-2 font-reospec z-10 text-3xl sm:text-5xl cursor-pointer font-bold hover:text-[#DB5413] duration-75"
				>M</a
			>
			<div
				class="relative border-[0.5px] border-gray-800 mx-auto z-60 flex py-4 px-4 sm:px-8 rounded-full justify-center items-center"
			>
				<div
					class="z-0 absolute inset-0 backdrop-blur-xs rounded-full"
				>
				</div>
				<div
					class="z-10 flex gap-8 items-center justify-center font-orbitron text-xs sm:text-sm"
				>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/projects">Projects</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/blog">Blog</a
					>
					<a
						class="cursor-pointer hover:opacity-80 font-semibold hover:text-[#DB5413] duration-75"
						href="/contact">Contact</a
					>
				</div>
			</div>
		</header>

		<!-- Main content -->
		<main class="py-24 font-expo px:4 px-96">
			<article>
				<ul
					class="flex flex-wrap gap-2 text-sm justify-center"
				>
					{
						tags.map((tag) => (
							<li
								class="px-2 py-0.5 uppercase tracking-wide
								   rounded-md border border-white/10
								   bg-white/5 text-white/70
								   hover:bg-white/10 hover:text-white transition"
							>
								{tag}
							</li>
						))
					}
				</ul>
				<h1 class="text-6xl text-center mt-5">
					{title}
				</h1>

				<div class="mt-14 h-96">
					{
						image && (
							<Image
								src={image}
								alt=""
								class="h-full object-cover rounded-md"
							/>
						)
					}
				</div>
				<div
					class="mt-4 mb-12 flex gap-3 justify-center items-center"
				>
					<FormattedDate date={pubDate} />

					<span
						class="h-5 w-px bg-white"
						aria-hidden="true"></span>

					<div class="flex items-center gap-1.5">
						<Icon
							name="lucide:clock-4"
							class="w-5 h-5"
						/>
						<p>
							{readingTime}
						</p>
					</div>
				</div>

				<slot />
			</article>
		</main>

		<footer class="grid place-items-center min-h-14">
			<div class="flex gap-2 items-center">
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:github"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="twitter"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
				<a class="p-1 group" href="#">
					<Icon
						name="lucide:mail"
						class="w-5 h-5 transition-transform group-hover:-translate-y-1 opacity-60 group-hover:opacity-90 duration-150"
					/>
				</a>
			</div>
		</footer>
	</body>
</html>
