---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";

const allBlogs = (await getCollection("blog")).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout>
	<h1 class="text-5xl sm:text-7xl text-center">My Blog</h1>
	<p class="mx-auto text-center mt-6 text-lg opacity-60 max-w-96 ">Short reads on what I am building, breaking, and figuring out along the way.</p>

	<section class=" max-w-[1200px] mx-auto grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-12 mt-12">
		{
		allBlogs.map((blog, index) => (
			<BlogCard blog={blog}, index={index}/>
			))
		}
	</section>
</Layout>
