---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { Image } from "astro:assets";
import { getReadingTime } from "../../../src/lib/reading-time.ts";
import { Icon } from "astro-icon/components";
import FormattedDate from "../../components//FormattedDate.astro";

const allBlogs = (await getCollection("blog")).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
console.log(allBlogs[0].data.tags);
---

<Layout>
	<h1 class="text-7xl text-center">My Blog</h1>

	<section class="w-[1200px] mx-auto flex flex-wrap gap-8 mt-12">
		{
			allBlogs.map((blog) => (
				<div class="w-[calc(50%-2rem)]  rounded-md ">
					<div class="relative overflow-hidden  h-[75%]">
						<Image
							src={blog.data.image}
							alt="blog image"
							class="rounded-md h-full  hover:scale-110 duration-300 "
						/>
						<div class="absolute w-full bottom-0 h-12  backdrop-blur-xs flex items-center justify-between px-4 text-sm font-bold">
							<FormattedDate
								date={
									blog
										.data
										.pubDate
								}
							/>

							<div class="flex items-center gap-1.5">
								<Icon
									name="lucide:clock-4"
									class="w-5 h-5 transition-transform group-hover:-translate-y-1 duration-150"
								/>
								{blog.body &&
									getReadingTime(
										blog.body,
									)}
							</div>
						</div>
					</div>

			<div class="px-2">

					<ul class="flex gap-2 mt-2 text-xs">
						{blog.data.tags.map((tag) => (
							<li class="border rounded-sm px-1.5 font-light uppercase bg-[#1dd3ff] text-black">
								{tag}
							</li>
						))}
					</ul>
					<h3 class="text-xl mt-3 line-clamp-1">
						{blog.data.title}
					</h3>
					<p class="mt-2 text-sm line-clamp-2">{blog.data.description}</p>
			</div>
				</div>
			))
		}
	</section>
</Layout>
