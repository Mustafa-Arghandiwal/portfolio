---
import Layout from "../layouts/Layout.astro";
import Prose from "../components/Prose.astro";
import { Icon } from "astro-icon/components";
---

<Layout>
	<div
		class="flex gap-12 justify-center items-center min-h-[calc(100vh-140px)] flex-col lg:flex-row"
	>
		<div
			class="rounded-full w-52 lg:w-74 grid place-items-center overflow-hidden pt-4 pl-3 group"
		>
			<img
				class="group-hover:scale-105 duration-300"
				src="/profile-black-hoodie-min.png"
				alt="profile image"
			/>
		</div>

		<div class="max-w-[600px]">
			<Prose>
				<div>
					<span
						class="text-primary text-3xl block font-bold"
					>
						<span transition:name="mustafa"
							>Mustafa</span
						> Arghandiwal
					</span>
					<div class="flex items-center gap-2">
						<Icon
							name="lucide:map-pin"
							class="w-5 h-5 text-primary"
						/>
						<span class="text-text">
							Kabul, Afghanistan
						</span>
					</div>
				</div>
				<p>
					I am a Web Developer focused on <span
						class="text-primary font-semibold"
						>Frontend Development.</span
					><br />
					I mainly work with <span
						class="text-primary font-semibold"
						>React</span
					>, <span
						class="text-primary font-semibold"
						>Astro</span
					><br />
					I use <span
						class="text-primary font-semibold"
						>Arch</span
					> (btw) with <span
						class="text-primary font-semibold"
						>Hyprland</span
					> as my daily driver,<br />
					and I code in <span
						class="text-primary font-semibold"
						>Neovim</span
					>.
					<br />
				</p>
				<h3>Connect:</h3>
				<div class="not-prose text-text flex gap-4">
					<div
						class="flex items-center gap-x-4 flex-wrap"
					>
						<a
							class="p-1 duration-150 hover:text-primary"
							href="https://github.com/Mustafa-Arghandiwal"
							target="_blank"
						>
							<Icon
								name="lucide:github"
							/>
						</a>
						<span
							class="text-text-faint select-none"
							>|</span
						>
						<a
							class="p-1 duration-150 hover:text-primary"
							href="https://x.com/_its_mustafa"
							target="_blank"
						>
							<Icon name="twitter" />
						</a>
						<span
							class="text-text-faint select-none"
							>|</span
						>
						<a
							class="p-1 font-medium duration-150 hover:text-primary flex gap-1 items-center"
							href="mailto:hi@itsmustafa.dev"
						>
							<Icon
								name="lucide:mail"
							/>
							hi@itsmustafa.dev
						</a>
					</div>
				</div>
			</Prose>
		</div>
	</div>

	<div class="mt-12">
		<h1 class="text-3xl text-center">Days I Code</h1>
		<div class="overflow-x-auto">
			<img
				src="http://ghchart.rshah.org/6f8faf/Mustafa-Arghandiwal"
				alt="chart"
				class="mt-8 h-38 min-w-[800px] mx-auto"
			/>
		</div>
	</div>
</Layout>
