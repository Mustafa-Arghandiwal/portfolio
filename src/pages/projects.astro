---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout pageTitle="Projects">
    <h1 class="text-center text-5xl md:text-6xl mt-8">Projects</h1>
    <p class="mx-auto text-center mt-6 text-lg text-text-muted max-w-96">
        Some of my work, built while learning
    </p>
    <section
        class="max-w-[1200px] min-h-[calc(70vh)] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 my-12"
    >
        <ProjectCard
            title="Job Seek"
            tags={["laravel", "mysql", "react", "inertia.js"]}
            image="/projects/job-seek.png"
            github="https://github.com/Mustafa-Arghandiwal/job-seek"
        >
            <p>
                A clean, minimal job application platform for both candidates
                and employers.
            </p>
            <ul>
                <li>Multiple user roles (candidate & employer)</li>
                <li>Drag-and-drop shortlisting for employers</li>
                <li>One click job applications</li>
                <li>SPA experience</li>
            </ul>
        </ProjectCard>

        <ProjectCard
            title="My Daily Journal"
            tags={["nodejs", "sqlite", "react", "typescript"]}
            image="/projects/my-daily-journal.png"
            github="https://github.com/Mustafa-Arghandiwal/my-daily-journal"
            live="https://journal.arghandiwal.dev"
        >
            <p>
                A personal journaling app built to make daily reflection simple
                and consistent, with streak tracking to encourage the habit.
            </p>
            <ul>
                <li>Authentication with persistent user sessions</li>
                <li>Create, view, edit, and organize journal entries</li>
                <li>Daily streak and longest streak tracking</li>
            </ul>
        </ProjectCard>
        <ProjectCard
            title="Portfolio"
            tags={["astro", "spline", "typescript"]}
            image="/projects/portfolio.png"
            github="https://github.com/Mustafa-Arghandiwal/portfolio"
            live="https://arghandiwal.dev"
        >
            <p>My portfolio and blog website showcasing projects and posts.</p>
            <ul>
                <li>Smooth, minimal, responsive design</li>
                <li>Multiple themes</li>
                <li>Blogging feature</li>
            </ul>
        </ProjectCard>
        <ProjectCard
            title="Hangman"
            tags={["react"]}
            image="/projects/hangman.png"
            github="https://github.com/Mustafa-Arghandiwal/hangman"
            live="https://play-hangman2.netlify.app/"
        >
            <p>
                A fun Hangman game themed around programming languages, built
                with React.
            </p>
        </ProjectCard>
    </section>
</Layout>
