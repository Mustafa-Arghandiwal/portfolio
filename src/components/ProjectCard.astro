---
import { Icon } from "astro-icon/components";
interface Props {
	title: string;
	tags: string[];
	image: string;
	github?: string;
	live?: string;
}
const { title, tags, image, github, live } = Astro.props;
---

<div class="border border-text/10 p-5 rounded-xl flex flex-col">
	<div class="rounded-md overflow-hidden max-h-72">
		<img
			class="h-full object-cover w-full hover:scale-110 duration-300"
			src={image}
		/>
	</div>
	<div class="flex gap-4 flex-wrap items-center mt-4">
		<h4 class="text-2xl">
			{title}
		</h4>
		<div class="flex gap-2 items-center">
			{
				github && (
					<a href={github} target="_blank">
						<Icon
							name="lucide:github"
							class="h-4 w-4 hover:scale-125 duration-150"
						/>
					</a>
				)
			}
			{
				live && (
					<a
						href={live}
						target="_blank"
						class=" flex items-center gap-1  px-1.5 rounded-sm text-white/90 bg-[#d20f39]/80  hover:scale-110 duration-150"
					>
						live
					</a>
				)
			}
		</div>
	</div>

	<div
		class="prose-sm sm:prose-base prose-invert mt-2 prose-ul:list-disc [&_p]:opacity-80 [&_ul]:opacity-80"
	>
		<slot />
	</div>

	<div class="mt-auto">
		
			<ul class="flex flex-wrap gap-2 text-sm">
				  {tags.map((tag: string) => {
				const asciiSum = tag.split('').map(char => char.charCodeAt(0)).reduce((acc, curr) => acc + curr, 0)
				const accent_colors = ['teal', 'orange', 'sapphire', 'maroon', 'mauve', 'pink']
				const tag_color = "text-" + accent_colors[asciiSum % accent_colors.length]
				    return (
			<li class=`${tag_color}  px-2 py-0.5 font-semibold tracking-wider cursor-default rounded-md bg-bg-card transition`>
					{tag}
				      </li>
				    )
				  })}
				</ul>

	</div>
</div>
