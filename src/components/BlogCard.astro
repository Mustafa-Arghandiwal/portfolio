
---
import { getReadingTime } from "../lib/reading-time"
import {Icon} from "astro-icon/components"
import TagChips from "./TagChips.astro"
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";

const {blog, index} = Astro.props
---


		<div class=`rounded-md ${index===0 && "sm:col-span-2 xl:col-span-3 sm:w-[75%]  sm:mx-auto"} overflow-hidden `>
			<a href={`/blog/${blog.id}`} class="cursor-pointer relative  block overflow-hidden group">
				{blog.data.image && 
						<Image
							transition:name={blog.id}
							src={blog.data.image}
							alt="blog image"
					class=`rounded-md ${index===0 ? "max-h-56 sm:max-h-96" : "h-56"}  hover:scale-110 duration-500`
						/>
				}
						<div class="absolute w-full -bottom-10 group-hover:bottom-0 duration-300 h-10 text-white/70  backdrop-blur-xs  flex flex-wrap items-center justify-between px-4 text-sm font-semibold">
							<FormattedDate
								date={
									blog
										.data
										.pubDate
								}
							/>

							<div class="flex items-center gap-1.5">
								<Icon
									name="lucide:clock-4"
									class="w-5 h-5"
								/>
								{blog.body &&
									getReadingTime(
										blog.body,
									)}
							</div>
						</div>
					</a>

			<div class="px-2 mt-2">

		{blog.data.tags.length !== 0 && 
			<div class="flex gap-x-4 gap-y-2 items-center flex-wrap">
			<Icon name="lucide:tag" class="text-text" />
			<TagChips tags={blog.data.tags} />
			
		</div>
		}
		
				
		<a href={`/blog/${blog.id}`} transition:name={blog.data.title} class=`${index===0 && "sm:text-4xl"}  text-2xl mt-1 line-clamp-3 `>
						{blog.data.title}
					</a>
					<p class="mt-1 line-clamp-3 text-text-muted text-justify">{blog.data.description}</p>
			</div>
				</div>
