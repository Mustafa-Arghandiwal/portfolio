---
import { Icon } from "astro-icon/components";

const currentPath = Astro.url.pathname;

// remove the empty ones ""
let segments = currentPath.split("/").filter(Boolean);

let breadCrumbs = [{ text: "～", href: "/", isHome: true }];

segments.forEach((segment, index) => {
	const href = "/" + segments.slice(0, index + 1).join("/");
	breadCrumbs.push({ text: segment, href: href, isHome: false });
});
---

{
breadCrumbs.map((crumb, index) => {
	if(index + 1 === breadCrumbs.length) {
		return (
		<span class="cursor-default">{crumb.isHome ? <Icon name="lucide:house" /> :crumb.text}</span>
		<span class="cursor-default">/</span>
		)
	}
		return (
			<a class="hover:text-primary duration-75" href={crumb.href}>
	{crumb.isHome ? <Icon name="lucide:house" /> :crumb.text}
			</a>
			<span class="cursor-default">/</span>
		);
	})
}

<div class="w-[1ch] h-4 bg-primary/70 animate-pulse"></div>
