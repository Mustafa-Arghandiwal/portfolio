---
const currentPath = Astro.url.pathname;
let segments = currentPath.split("/");
let breadCrumbs = [];
// home path always gives ["", ""], because of "/".split("/"), so handling that here.
if (segments.length === 2 && segments[0] === "" && segments[1] === "") {
	breadCrumbs.push({ text: "～", href: "/" });
} else {
	segments.forEach((segment, index) => {
		if (segment === "") {
			breadCrumbs.push({ text: "～", href: "/" });
		} else {
			const href = "/" +  segments.slice(1, index + 1).join("/");
			breadCrumbs.push({ text: segment, href: href });
		}
	});
}
---

{
breadCrumbs.map((crumb, index) => {
	if(index + 1 === breadCrumbs.length) {
		return (
		<span class="cursor-default">{crumb.text}</span>
		<span class="cursor-default">/</span>
		)
	}
		return (
			<a class="hover:text-primary duration-75" href={crumb.href}>
				{crumb.text}
			</a>
			<span class="cursor-default">/</span>
		);
	})
}

<div class="w-[1ch] h-4 bg-primary/70 animate-pulse"></div>
